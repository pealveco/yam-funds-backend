# Copy this file to .env.local for host runs with IntelliJ or ./gradlew bootRun.
# Copy it to .env.compose if you want to pass an env file to Docker Compose.
# Copy it to .env.prod only as a starting point for AWS environment variables.
# Do not commit real .env files.

SPRING_PROFILES_ACTIVE=local
AWS_REGION=us-east-1

# Host runs use http://localhost:8000.
# Docker Compose app container uses http://dynamodb-local:8000.
AWS_DYNAMODB_ENDPOINT=http://localhost:8000

DYNAMODB_SEED_ENABLED=true
DYNAMODB_CLIENTS_TABLE=yam-funds-clients
DYNAMODB_FUNDS_TABLE=yam-funds-funds
DYNAMODB_SUBSCRIPTIONS_TABLE=yam-funds-subscriptions
DYNAMODB_TRANSACTIONS_TABLE=yam-funds-transactions
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080
